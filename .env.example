OPENAI_API_KEY=sk-your-key-here

# Optional: override the chat model used by every node (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: where triages are saved (default: data/checkpoints.sqlite)
# CHECKPOINT_DB=data/checkpoints.sqlite

# Optional: where OpenAI responses are cached (default: data/llm_cache.sqlite).
# Set to "off" to always call OpenAI.
# LLM_CACHE_DB=data/llm_cache.sqlite
